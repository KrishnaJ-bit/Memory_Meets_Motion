    {
      "id": "tool_http_request_1",
      "provider": "tool_http_request",
      "config": {
        "type": "tool_http_request",
        "allowGET": false,
        "allowPOST": true,
        "allowPUT": false,
        "allowPATCH": false,
        "allowDELETE": false,
        "allowHEAD": false,
        "allowOPTIONS": false,
        "rateLimitPerSecond": 2,
        "rateLimitPerMinute": 20,
        "maxConcurrentRequests": 1,
