{
	"components": [
		{
			"id": "webhook_1",
			"provider": "webhook",
			"config": { "hideForm": true, "mode": "Source", "parameters": {}, "type": "webhook" },
			"ui": { "position": { "x": 20, "y": 200 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "summarization_1",
			"provider": "summarization",
			"config": {
				"profile": "default",
				"default": {
					"numberOfSummaries": 1,
					"numberOfSummaryWords": 180,
					"numberOfKeyPointWords": 20,
					"numberOfEntities": 8
				},
				"parameters": {}
			},
			"input": [{ "lane": "text", "from": "webhook_1" }],
			"ui": { "position": { "x": 240, "y": 200 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "question_1",
			"provider": "question",
			"config": { "type": "question", "parameters": {} },
			"input": [{ "lane": "text", "from": "summarization_1" }],
			"ui": { "position": { "x": 460, "y": 200 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "agent_rocketride_1",
			"provider": "agent_rocketride",
			"config": {
				"agent_description": "Relay decision emitter. Turns a summarized LaserData session-event batch into structured Decision records and publishes them to the LaserData graph-mutation stream.",
				"instructions": [
					"You receive a summary of a batch of raw developer-session events captured on the LaserData stream 'dev.session.events' (L1).",
					"Extract the structured decisions the developer made: what was tried, what was rejected, the reason for each switch, any blocker hit, and the next step that was pending when the session paused.",
					"Return a JSON array named 'decisions'. Each element must have: decision_id, task_id, session_id, text, reasoning, related_files (array), blocker (string or null), next_step (string or null).",
					"For every decision you emit, call the HTTP tool once to POST the record to the LaserData stream endpoint in ${ROCKETRIDE_LASERDATA_STREAM_URL}, with topic 'relay.graph.mutations' (L2) and an envelope of the shape { session_id, task_id, event_type: 'graph_write', timestamp, payload }.",
					"Use ISO-8601 UTC timestamps. Never invent a task_id or session_id that was not present in the input.",
					"Do not attempt any HTTP call to a host outside the configured whitelist; the tool will reject it."
				],
				"max_waves": 6,
				"parameters": {}
			},
			"input": [{ "lane": "questions", "from": "question_1" }],
			"ui": { "position": { "x": 680, "y": 200 }, "measured": { "width": 150, "height": 86 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "response_answers_1",
			"provider": "response_answers",
			"config": { "laneName": "answers" },
			"input": [{ "lane": "answers", "from": "agent_rocketride_1" }],
			"ui": { "position": { "x": 900, "y": 200 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "llm_openai_1",
			"provider": "llm_openai",
			"config": {
				"profile": "openai-5-nano",
				"openai-5-nano": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" },
				"parameters": {}
			},
			"control": [
				{ "classType": "llm", "from": "summarization_1" },
				{ "classType": "llm", "from": "agent_rocketride_1" }
			],
			"ui": { "position": { "x": 460, "y": 380 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "memory_internal_1",
			"provider": "memory_internal",
			"config": { "type": "memory_internal" },
			"control": [{ "classType": "memory", "from": "agent_rocketride_1" }],
			"ui": { "position": { "x": 680, "y": 380 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "tool_http_request_1",
			"provider": "tool_http_request",
			"config": {
				"type": "tool_http_request",
				"allowGET": true,
				"allowPOST": true,
				"allowPUT": false,
				"allowPATCH": false,
				"allowDELETE": false,
				"allowHEAD": false,
				"allowOPTIONS": false,
				"rateLimitPerSecond": 10,
				"rateLimitPerMinute": 100,
				"maxConcurrentRequests": 5,
				"urlWhitelist": [{ "whitelistPattern": "${ROCKETRIDE_LASERDATA_URL_PATTERN}" }]
			},
			"control": [{ "classType": "tool", "from": "agent_rocketride_1" }],
			"ui": { "position": { "x": 880, "y": 380 }, "measured": { "width": 150, "height": 40 }, "nodeType": "default", "formDataValid": true }
		}
	],
	"project_id": "bba6f80c-0a42-456d-a0c4-f7a25af99293",
	"viewport": { "x": 0, "y": 0, "zoom": 1 },
	"version": 1
}
