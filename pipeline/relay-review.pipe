{
  "components": [
    {
      "id": "chat_1",
      "provider": "chat",
      "config": { "hideForm": true, "mode": "Source", "parameters": {}, "type": "chat" },
      "ui": { "position": { "x": 20, "y": 200 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
    },
    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "config": {
        "agent_description": "Relay PR risk reviewer. Reads the pull request the resume agent opened and checks its claims against its own diff before a human sees it.",
        "instructions": [
          "You review a pull request opened by Relay's resume agent while nobody was watching. The question carries the PR number and the task_id.",
          "Read the PR body, the changed files and the commits with the GitHub tool. Read them before judging — never review from the title alone.",
          "Compare what the PR claims against what the diff shows. That comparison is the job: a body that says tests passed, with a diff that weakens the assertion instead of fixing the code, is the failure this node exists to catch.",
          "Cross-check the memory graph with the FalkorDB tool (read-only): confirm the Blocker the PR claims to close is actually marked resolved, and that the files it touched are the ones the blocked Step modified. A PR that closes a blocker it never addressed is a hard fail.",
          "Flag, in order of seriousness: a weakened or deleted test; changes outside the scope of the stated blocker; a body that never states a test result; a diff larger than the blocker justifies.",
          "Post one review comment with your findings. Do not approve — you surface risk, a human decides.",
          "If you find nothing concerning, say exactly that in one line. Inventing concerns to look thorough trains people to ignore you."
        ],
        "max_waves": 8,
        "parameters": {}
      },
      "input": [{ "lane": "questions", "from": "chat_1" }],
      "ui": { "position": { "x": 240, "y": 200 }, "measured": { "width": 150, "height": 86 }, "nodeType": "default", "formDataValid": true }
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "config": { "laneName": "answers" },
      "input": [{ "lane": "answers", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 460, "y": 200 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
    },
    {
      "id": "llm_gemini_1",
      "provider": "llm_gemini",
      "config": {
        "profile": "gemini-2_5-pro",
        "gemini-2_5-pro": { "apikey": "${ROCKETRIDE_GEMINI_KEY}" },
        "parameters": {}
      },
      "control": [{ "classType": "llm", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 60, "y": 380 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
    },
    {
      "id": "memory_internal_1",
      "provider": "memory_internal",
      "config": { "type": "memory_internal" },
      "control": [{ "classType": "memory", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 230, "y": 380 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
    },
    {
      "id": "tool_github_1",
      "provider": "tool_github",
      "config": {
        "type": "tool_github",
        "token": "${ROCKETRIDE_GITHUB_TOKEN}",
        "defaultRepo": "${ROCKETRIDE_TARGET_REPO}",
        "readOnly": false
      },
      "control": [{ "classType": "tool", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 400, "y": 380 }, "measured": { "width": 150, "height": 40 }, "nodeType": "default", "formDataValid": true }
    },
    {
      "id": "tool_falkordb_1",
      "provider": "tool_falkordb",
      "config": {
        "type": "tool_falkordb",
        "host": "${ROCKETRIDE_FALKORDB_HOST}",
        "port": 55419,
        "username": "${ROCKETRIDE_FALKORDB_USERNAME}",
        "password": "${ROCKETRIDE_FALKORDB_PASSWORD}",
        "tls": false,
        "graph": "${ROCKETRIDE_FALKORDB_GRAPH}",
        "allow_writes": false,
        "max_rows": 250,
        "query_timeout_ms": 30000
      },
      "control": [{ "classType": "tool", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 570, "y": 380 }, "measured": { "width": 150, "height": 40 }, "nodeType": "default", "formDataValid": true }
    }
  ],
  "project_id": "073882a3-dffb-4285-bf70-269abfbe0723",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
