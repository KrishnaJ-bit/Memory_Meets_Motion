{"offset":0,"payload":{"session_id":"sess_46f3fcca","task_id":"alpha","event_type":"graph_write","timestamp":"2026-08-03T19:10:23.456Z","payload":{"graph":"task_alpha","kind":"MERGE_NODE","cypher_file":"merge_task.cypher","query":"// F1: idempotent write for the task_started event. Replay-safe (MERGE, not CREATE) — running\n// this twice for the same $id is a no-op beyond the ON MATCH refresh.\nMERGE (t:Task {id: $id})\nON CREATE SET\n  t.session_id = $session_id,\n  t.title = $title,\n  t.status = $status,\n  t.created_at = $created_at\nON MATCH SET\n  t.status = $status\nRETURN t\n","params":{"id":"alpha","session_id":"sess_46f3fcca","title":"Build capture + memory layer for Relay","status":"open","created_at":"2026-08-03T19:10:35.343Z"},"source_event_type":"note","nodes_created":1,"relationships_created":0,"properties_set":4}}}
{"offset":1,"payload":{"session_id":"sess_46f3fcca","task_id":"alpha","event_type":"graph_write","timestamp":"2026-08-03T19:10:23.458Z","payload":{"graph":"task_alpha","kind":"MERGE_NODE","cypher_file":"merge_step.cypher","query":"// F1: idempotent write for step_started / step_completed events (root EXECUTION.md Section 2:\n// `(:Step {id, order, description, status})`).\n//\n// HAS_STEP is a deliberate addition beyond Section 2's illustrative edge list — see the note atop\n// src/shared/graph-contract.ts for why Task needs a direct edge to its Steps for F2 to work.\n// NEXT chains steps in the order they started, matching Section 2's `Step-[:NEXT]->Step`.\nMATCH (t:Task {id: $task_id})\nMERGE (s:Step {id: $id})\nON CREATE SET\n  s.task_id = $task_id,\n  s.order = $order,\n  s.description = $description,\n  s.status = $status,\n  s.started_at = $started_at,\n  s.completed_at = $completed_at\nON MATCH SET\n  s.status = $status,\n  s.completed_at = $completed_at\nMERGE (t)-[:HAS_STEP]->(s)\nWITH t, s\nOPTIONAL MATCH (t)-[:HAS_STEP]->(prev:Step {order: s.order - 1})\nFOREACH (_ IN CASE WHEN prev IS NOT NULL THEN [1] ELSE [] END | MERGE (prev)-[:NEXT]->(s))\nRETURN s\n","params":{"id":"step_1","task_id":"alpha","order":0,"description":"read repo docs","status":"started","started_at":"2026-08-03T19:10:36.343Z","completed_at":null},"source_event_type":"note","nodes_created":1,"relationships_created":1,"properties_set":6}}}
{"offset":2,"payload":{"session_id":"sess_46f3fcca","task_id":"alpha","event_type":"graph_write","timestamp":"2026-08-03T19:10:23.458Z","payload":{"graph":"task_alpha","kind":"MERGE_NODE","cypher_file":"merge_file.cypher","query":"// F1: idempotent write for file_save / diff events (root EXECUTION.md Section 2: `(:File\n// {path})`, edge `Step-[:MODIFIES]->File`). File nodes are keyed purely by path, so touching the\n// same file across steps/tasks converges on one node — File.path is process-wide, not per-task,\n// which is intentional: it's what makes \"which steps/tasks touched this file\" answerable later.\nMATCH (s:Step {id: $step_id})\nMERGE (f:File {path: $path})\nMERGE (s)-[:MODIFIES]->(f)\nRETURN f\n","params":{"step_id":"step_1","path":"capture/src/read_repo_docs.ts"},"source_event_type":"file_save","nodes_created":1,"relationships_created":1,"properties_set":1}}}
