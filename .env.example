# Copy this file to .env and fill in real values. Never commit .env.
# Variable names below are placeholders. Confirm exact names against each
# sponsor's current SDK/docs before wiring up code.

# LaserData
# Track 1 verified the real @laserdata/laser-sdk (0.0.1): it takes one connection string
# (`user:pass@host:port`, via Laser.connect()), not a token+URL pair. Put that connection string
# in LASERDATA_STREAM_URL (capture/src/laser/liveClient.ts reads it first, falling back to
# LASER_CONNECTION_STRING). LASERDATA_API_TOKEN is kept for LaserData Cloud's real auth once
# confirmed against live docs — not yet consumed by any adapter.
LASERDATA_API_TOKEN=
LASERDATA_STREAM_URL=
LASER_CONNECTION_STRING=

# FalkorDB
# Track 1 verified the real falkordb client (6.7.0): memory/src/falkor/liveClient.ts reads
# FALKORDB_URL directly (redis://[user]:[pass]@host:port), falling back to discrete
# FALKOR_HOST/FALKOR_PORT/FALKOR_USERNAME/FALKOR_PASSWORD if unset.
FALKORDB_URL=redis://localhost:6379
FALKORDB_CLOUD_TOKEN=
FALKOR_HOST=
FALKOR_PORT=
FALKOR_USERNAME=
FALKOR_PASSWORD=

# Guild.ai
GUILD_API_KEY=
GUILD_WORKSPACE_ID=
GUILD_GATEWAY_URL=https://gateway.guild.ai

# RocketRide
ROCKETRIDE_API_KEY=
ROCKETRIDE_CLOUD_TOKEN=

# LLM provider(s) used inside the RocketRide Reason / CodeEdit nodes
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub (for the relay-resume agent's scoped PR access, via Guild's credential vault)
GITHUB_TOKEN=
