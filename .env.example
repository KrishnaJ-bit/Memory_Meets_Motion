# Copy this file to .env and fill in real values. Never commit .env.
# These names match the current SDKs checked on 2026-08-03.

# Account identifiers
GITHUB_USERNAME=
GITHUB_ACCOUNT_EMAIL=

# LaserData
# Track 1 verified the real @laserdata/laser-sdk (0.0.1): it takes one connection string
# (`user:pass@host:port`, via Laser.connect()), not a token+URL pair. Track 2's client calls
# Laser.connectEnv(), which reads LASER_CONNECTION_STRING (+ optional LASER_STREAM); Track 1's
# adapter reads LASERDATA_STREAM_URL first, falling back to LASER_CONNECTION_STRING.
# Set BOTH to the same connection string. LASERDATA_API_TOKEN is not consumed by any adapter yet.
LASER_CONNECTION_STRING=
LASER_STREAM=dev
LASERDATA_STREAM_URL=
LASERDATA_API_TOKEN=

# FalkorDB
# Track 1 verified the real falkordb client (6.7.0): memory/src/falkor/liveClient.ts reads
# FALKORDB_URL directly (redis://[user]:[pass]@host:port), falling back to discrete
# FALKOR_HOST/FALKOR_PORT/FALKOR_USERNAME/FALKOR_PASSWORD if unset.
FALKORDB_URL=redis://localhost:6379
FALKORDB_GRAPH_PREFIX=relay
FALKORDB_CLOUD_TOKEN=
FALKOR_HOST=
FALKOR_PORT=
FALKOR_USERNAME=
FALKOR_PASSWORD=

# Guild.ai
# Guild CLI stores OAuth tokens in the OS credential store after `guild auth login`.
GUILD_API_BASE_URL=https://app.guild.ai/api
GUILD_API_KEY=
GUILD_WORKSPACE_ID=
GUILD_GATEWAY_URL=https://app.guild.ai/api

# RocketRide
# Current SDK reads ROCKETRIDE_APIKEY and ROCKETRIDE_URI.
ROCKETRIDE_APIKEY=
ROCKETRIDE_URI=wss://api.rocketride.ai
ROCKETRIDE_API_KEY=
ROCKETRIDE_CLOUD_TOKEN=

# LLM provider(s) used inside the RocketRide Reason / CodeEdit nodes
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub (for the relay-resume agent's scoped PR access, via Guild's credential vault)
GITHUB_TOKEN=
