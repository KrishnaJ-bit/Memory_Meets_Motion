# Copy this file to .env and fill in real values. Never commit .env.
# Variable names below are placeholders. Confirm exact names against each
# sponsor's current SDK/docs before wiring up code.

# LaserData
LASERDATA_API_TOKEN=
LASERDATA_STREAM_URL=

# FalkorDB
FALKORDB_URL=redis://localhost:6379
FALKORDB_CLOUD_TOKEN=

# Guild.ai
GUILD_API_KEY=
GUILD_WORKSPACE_ID=
GUILD_GATEWAY_URL=https://gateway.guild.ai

# RocketRide
ROCKETRIDE_API_KEY=
ROCKETRIDE_CLOUD_TOKEN=

# LLM provider(s) used inside the RocketRide Reason / CodeEdit nodes
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub (for the relay-resume agent's scoped PR access, via Guild's credential vault)
# Use a fine-grained token scoped to the target repo only. The resume agent
# refuses to run if it can prove the token reaches any other repo.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# RocketRide pipeline variables (Track 2)
#
# RocketRide only substitutes ${...} placeholders inside .pipe files when the
# variable name starts with ROCKETRIDE_ — so the values above are duplicated
# here under that prefix on purpose. Verified against
# .rocketride/docs/ROCKETRIDE_COMMON_MISTAKES.md → Mistake 11.
#
# ROCKETRIDE_URI and ROCKETRIDE_APIKEY are managed by the RocketRide VS Code
# extension; do not hand-edit them once the extension is connected.
# ---------------------------------------------------------------------------
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=

# Models used by the pipelines. R2 routes deliberately: openai-5-mini for the
# Reason node, claude-opus-4-6 for the CodeEdit sub-agent.
ROCKETRIDE_OPENAI_KEY=
ROCKETRIDE_ANTHROPIC_KEY=

# LaserData is NOT reachable from inside a pipeline: the SDK speaks Apache Iggy
# over TCP, so no RocketRide HTTP tool node can publish or replay. The L1 replay
# and the L2/L3 writes happen in orchestration/ via @laserdata/laser-sdk, using
# LASER_CONNECTION_STRING above.
#
# This pattern is the regex whitelist on the one remaining HTTP tool (Slack) —
# the resume agent cannot call any host that does not match it.
ROCKETRIDE_SLACK_URL_PATTERN=^https://hooks\.slack\.com/services/.*$

# FalkorDB, as seen from inside the pipelines (F2/F3/F4 reads, F6 write-back).
# Port and TLS are literals in the .pipe files: RocketRide only substitutes
# string values, so a non-6379 port must be edited in pipeline/*.pipe directly.
ROCKETRIDE_FALKORDB_HOST=localhost
ROCKETRIDE_FALKORDB_USERNAME=
ROCKETRIDE_FALKORDB_PASSWORD=
ROCKETRIDE_FALKORDB_GRAPH=relay

# GitHub + the task under demo, used by the R2 code-edit sub-agent.
# Values match the scenario frozen in demo/scenario.json: the toy repo lives at
# demo/toy-repo inside this repository, so the PR is opened against this repo.
ROCKETRIDE_GITHUB_TOKEN=
ROCKETRIDE_TARGET_REPO=KrishnaJ-bit/Memory_Meets_Motion
ROCKETRIDE_TARGET_TASK_ID=task-checkout-rate-limit

# Slack webhook for the R2 NotifySlack node.
SLACK_WEBHOOK_URL=
